NODE_ENV=development
PORT=4000

# Local docker-compose postgres. See docker-compose.yml.
DATABASE_URL=postgresql://garden:garden@localhost:5432/garden_manager

# Generate a real secret with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-random-32-plus-character-secret
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Automatic triage and queued notification delivery.
AUTOMATION_INTERVAL_SECONDS=300

# Browser/mobile Web Push. Generate a pair with:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:garden-manager@localhost

# Email delivery. Leave SMTP_HOST empty to keep email disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Garden Manager <garden-manager@localhost>
